from typing import Any, Optional, Union, Dict, List, Tuple, Callable, Sequence

from typing import Any
from mini_pix.server_grpc.async_pixet_grpc_client import AsyncPixetGrpcClient
class SyncPixetGrpcClient(AsyncPixetGrpcClient):
    def __init__(self, server_ip: str, server_port: int, timeout_sec: Optional[float] = ..., logger: Optional[Any] = ..., log_level: Optional[str] = ...) -> None: ...
    def disconnect(self) -> Any: ...
    def connect(self) -> bool: ...
    def set_mode_all(self, mode: str) -> bool: ...
    def set_threshold(self, threshold_kev: float) -> bool: ...
    def set_clock(self, clock_mhz: float) -> bool: ...
    def set_bias(self, bias_volt: float) -> bool: ...
    def get_frame_size(self, frame: Any, data_len: int) -> Tuple[int, int]: ...
    def get_acq_frame_count(self) -> int: ...
    def get_acq_frames(self, idx: Optional[int] = ...) -> dict: ...
    def get_acq_data_count(self) -> Any: ...
    def get_acq_data(self, idx: Any) -> dict: ...
    def simple_int_acq(self, count: int, sec: float, name: str = ..., file_type: str = ..., *, save_file: bool = ..., return_data: bool = ...) -> Any: ...

    # --- methods defined in .py, not in ctrl-derived pyi ---
    def _simple_acq_sync(self, count: int, sec: float, name: str = ..., *, save_file: bool = ..., save_local: bool = ..., return_data: bool = ...) -> Any: ...
    def simple_acq(self, count: int, sec: float, name: str = ..., *, save_file: bool = ..., save_local: bool = ..., return_data: bool = ...) -> Any: ...
