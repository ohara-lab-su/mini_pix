from typing import Any, Optional, Union, Dict, List, Tuple, Callable, Sequence

from typing import Any
from mini_pix.server_grpc.async_pixet_grpc_client import AsyncPixetGrpcClient
class SyncPixetGrpcClient(AsyncPixetGrpcClient):
    def __init__(self, server_ip: str, server_port: int, timeout_sec: Optional[float] = ..., logger: Optional[Any] = ..., log_level: Optional[str] = ..., grpc_options: Optional[Sequence[Tuple[str, Any]]] = ..., set_timeout_sec: Optional[float] = ...) -> None: ...
    def connect(self) -> bool: ...
    def disconnect(self) -> Any: ...
    def set_mode_all(self, mode: str) -> bool: ...
    def set_threshold(self, threshold_kev: float) -> bool: ...
    def set_clock(self, clock_mhz: float) -> bool: ...
    def set_bias(self, bias_volt: float) -> bool: ...
    def get_frame_size(self, frame: Any, data_len: int) -> Tuple[int, int]: ...
    def clear_frames(self) -> Any: ...
    def get_frame_count(self) -> int: ...
    def get_frame(self, index: int) -> Dict[str, Any]: ...
    def get_frames(self) -> List[Dict[str, Any]]: ...
    def get_current_frame(self) -> Optional[Dict[str, Any]]: ...
    def get_acq_frame_count(self) -> int: ...
    def get_acq_frames(self, idx: Optional[int] = ...) -> Dict[str, Any]: ...
    def acquire(self, count: int, sec: float, acquisition_type: str = ..., callback: Optional[Callable[[Dict[str, Any]], None]] = ..., save_format: Optional[str] = ..., save_path: Optional[str] = ...) -> Dict[str, Any]: ...
    def acquire_frames(self, count: int, sec: float, callback: Optional[Callable[[Dict[str, Any]], None]] = ..., save_format: Optional[str] = ..., save_path: Optional[str] = ...) -> Dict[str, Any]: ...
    def acquire_integral(self, count: int, sec: float, callback: Optional[Callable[[Dict[str, Any]], None]] = ..., save_format: Optional[str] = ..., save_path: Optional[str] = ...) -> Dict[str, Any]: ...
    def stop(self) -> Any: ...
    def is_running(self) -> bool: ...
    def is_aborting(self) -> bool: ...
    def state(self) -> Dict[str, Any]: ...

    # --- methods defined in .py, not in ctrl-derived pyi ---
    def _simple_acq_sync(self, count: int, sec: float, name: str = ..., *, save_file: bool = ..., save_local: bool = ..., return_data: bool = ...) -> Any: ...
    def simple_acq(self, count: int, sec: float, name: str = ..., *, save_file: bool = ..., save_local: bool = ..., return_data: bool = ...) -> Any: ...
