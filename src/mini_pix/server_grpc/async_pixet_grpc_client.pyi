from typing import Any, Optional, Union, Dict, List, Tuple, Callable, Sequence

from typing import Any
from grpc_frame import AsyncGrpcClient
class AsyncPixetGrpcClient(AsyncGrpcClient):
    def __init__(self, server_ip: str, server_port: int, timeout_sec: Optional[float] = ..., logger: Optional[Any] = ..., log_level: Optional[str] = ..., grpc_options: Optional[Sequence[Tuple[str, Any]]] = ..., set_timeout_sec: Optional[float] = ...) -> None: ...
    async def connect(self) -> bool: ...
    async def disconnect(self) -> Any: ...
    async def set_mode_all(self, mode: str) -> bool: ...
    async def set_threshold(self, threshold_kev: float) -> bool: ...
    async def set_clock(self, clock_mhz: float) -> bool: ...
    async def set_bias(self, bias_volt: float) -> bool: ...
    async def get_frame_size(self, frame: Any, data_len: int) -> Tuple[int, int]: ...
    async def clear_frames(self) -> Any: ...
    async def get_frame_count(self) -> int: ...
    async def get_frame(self, index: int) -> Dict[str, Any]: ...
    async def get_frames(self) -> List[Dict[str, Any]]: ...
    async def get_current_frame(self) -> Optional[Dict[str, Any]]: ...
    async def get_acq_frame_count(self) -> int: ...
    async def get_acq_frames(self, idx: Optional[int] = ...) -> Dict[str, Any]: ...
    async def acquire(self, count: int, sec: float, acquisition_type: str = ..., callback: Optional[Callable[[Dict[str, Any]], None]] = ..., save_format: Optional[str] = ..., save_path: Optional[str] = ...) -> Dict[str, Any]: ...
    async def stop(self) -> Any: ...
    async def is_running(self) -> bool: ...
    async def is_aborting(self) -> bool: ...
    async def state(self) -> Dict[str, Any]: ...

    # --- methods defined in .py, not in ctrl-derived pyi ---
    @staticmethod
    def _make_png_chunk(chunk_type: bytes, data: bytes) -> bytes: ...
    @classmethod
    def _write_png(cls, path: Any, data: Any) -> None: ...
    @classmethod
    def _save_result_files(cls, result: dict, name: str) -> None: ...
    @classmethod
    def _finish_acquisition(cls, result: dict, name: str, save_local: bool, return_data: bool) -> Any: ...
    async def _acquire_frames_async(self, count: int, sec: float, name: str = ..., *, save_local: bool = ..., return_data: bool = ..., save_format: Any = ..., save_path: Any = ...) -> Any: ...
    async def _acquire_integral_async(self, count: int, sec: float, name: str = ..., *, save_local: bool = ..., return_data: bool = ..., save_format: Any = ..., save_path: Any = ...) -> Any: ...
    async def acquire_frames(self, count: int, sec: float, name: str = ..., *, save_local: bool = ..., return_data: bool = ..., save_format: Any = ..., save_path: Any = ...) -> Any: ...
    async def acquire_integral(self, count: int, sec: float, name: str = ..., *, save_local: bool = ..., return_data: bool = ..., save_format: Any = ..., save_path: Any = ...) -> Any: ...
