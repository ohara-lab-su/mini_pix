from typing import Any, Optional, Union, Dict, List, Tuple, Callable, Sequence

class AsyncPixetGrpcClient:
    def __init__(self, config: Optional[Any] = ..., server_ip: Optional[str] = ..., server_port: Optional[int] = ..., timeout_sec: Optional[float] = ..., logger: Optional[Any] = ..., log_level: Optional[str] = ...) -> None: ...
    def wait_for_ready(self, timeout_sec: float = ...) -> bool: ...
    def is_connected(self) -> bool: ...
    def close(self) -> None: ...
    def subscribe(self, *, topic: str, once: bool = ..., source: str = ...) -> Any: ...
    async def disconnect(self) -> Any: ...
    async def connect(self) -> Any: ...
    async def set_mode_all(self, mode: str) -> Any: ...
    async def set_threshold(self, threshold: float) -> Any: ...
    async def simple_acq(self, count: int, sec: float, name: str = ..., *, save_file: bool = ..., return_data: bool = ...) -> Any: ...