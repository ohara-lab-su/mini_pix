from typing import Any, Optional, Union, Dict, List, Tuple, Callable, Sequence

class PixetGrpcClient:
    def __init__(
        self,
        config: Optional[Any] = ...,
        server_ip: Optional[str] = ...,
        server_port: Optional[int] = ...,
        timeout_sec: Optional[float] = ...,
        logger: Optional[Any] = ...,
        log_level: Optional[str] = ...,
    ) -> None: ...
    def wait_for_ready(self, timeout_sec: float = ...) -> bool: ...
    def is_connected(self) -> bool: ...
    def close(self) -> None: ...
    def subscribe(self, *, topic: str, once: bool = ..., source: str = ...): ...
    def disconnect(self) -> Any: ...
    def connect(self) -> Any: ...
    def set_mode_all(self, mode: str) -> Any: ...
    def set_threshold(self, threshold: float) -> Any: ...
    def simple_acq(self, count: int, sec: float, name: str = ...) -> Any: ...
